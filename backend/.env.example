# ConstructOS Backend — Environment Variables
# Copy this to .env and fill in your values

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Groq ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama3-70b-8192
GROQ_EMBEDDING_MODEL=llama3-8b-8192   # used for embeddings if not using sentence-transformers

# --- Storage bucket names ---
MASTER_PLANS_BUCKET=master-plans
QUOTATIONS_BUCKET=quotations

# --- Security ---
SECRET_KEY=your-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Anonymous session ---
ANONYMOUS_SESSION_EXPIRE_HOURS=24

# --- Quotation processing ---
QUOTATION_RETENTION_DAYS=30
MAX_QUOTATION_FILE_SIZE_MB=20
OCR_CONFIDENCE_THRESHOLD=0.6    # below this, show degraded-confidence warning

# --- Rate limiting ---
PUBLIC_CHAT_MAX_MESSAGES_PER_SESSION=50
PUBLIC_UPLOAD_MAX_PER_SESSION=5
PUBLIC_UPLOAD_MAX_PER_IP_PER_HOUR=10

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- Misc ---
ENV=development
LOG_LEVEL=INFO
